<UserControl x:Class="Ognia.Frontend.Views.Auth.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PaneBorder}">
        <Grid Style="{StaticResource PaneContent}">
            <StackPanel>
                <!-- Back button -->
                <Button Content="↩"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource IconButton}"/>

                <!-- Title-->
                <TextBlock Text="Reset password" 
                           Style="{StaticResource TitleText}"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           Style="{StaticResource PrimaryTextBlock}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Reset" 
                        Command="{Binding RequestTokenCommand}"/>

                <!-- Token -->
                <TextBlock Text="Token"
                           Style="{StaticResource PrimaryTextBlock}"/>
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"/>
            
                <!-- Password -->
                <TextBlock Text="New password"
                           Style="{StaticResource PrimaryTextBlock}"/>
                <PasswordBox x:Name="NewPasswordBox" 
                             PasswordChanged="NewPasswordBox_PasswordChanged"/>
                <Button Content="Reset password" 
                        Command="{Binding ResetPasswordCommand}"/>

                <TextBlock Text="{Binding StatusMessage}" 
                           TextWrapping="Wrap" 
                           Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>