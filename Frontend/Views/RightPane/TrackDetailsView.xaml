<UserControl x:Class="Ognia.Frontend.Views.RightPane.TrackDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Width="180" Height="180" CornerRadius="6" Margin="0,0,0,10"
                    Style="{StaticResource HoverTile}"
                    Cursor="Hand"
                    Background="{DynamicResource TextboxBackgroundColor}"
                    HorizontalAlignment="Center" ClipToBounds="True"
                    MouseLeftButtonUp="Thumbnail_Click">
                <Image Source="{Binding TrackThumbnailPath, Converter={StaticResource StringToImageSource}}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="{Binding TrackName}"
                       Style="{StaticResource SubtitleText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>

            <TextBlock Text="{Binding TrackDuration, StringFormat='Duration: {0:mm\\:ss}'}"
                       Style="{StaticResource BodyText}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>

            <Separator/>

            <StackPanel Visibility="{Binding IsRenameOpen, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="New name" Style="{StaticResource PrimaryTextBlock}"/>
                <TextBox Text="{Binding RenameInput, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Content="✓"
                            Command="{Binding ConfirmRenameCommand}"
                            Style="{StaticResource IconButton}"
                            Width="40" Height="40"
                            ToolTip="Save"/>
                    <Button Content="✕"
                            Command="{Binding CancelRenameCommand}"
                            Style="{StaticResource IconButton}"
                            Width="40" Height="40"
                            ToolTip="Cancel"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <!-- Control button visibility when renaming -->
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenameOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Row 1: Rename, Remove, Download -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="✎" Command="{Binding RenameTrackCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Rename track"/>
                    <Button Content="🗙" Command="{Binding RemoveTrackCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Remove track from playlist"/>
                    <Button Content="⤓" Command="{Binding DownloadCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Download"/>
                </StackPanel>

                <!-- Row 2: Remove download, Open location -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="━" Command="{Binding RemoveDownloadCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Remove download"/>
                    <Button Content="📁" Command="{Binding OpenLocationCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Open file location"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>