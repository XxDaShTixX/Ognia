<UserControl x:Class="Ognia.Frontend.Views.MainPane.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Style="{StaticResource PrimaryDockPanel}">

            <TextBlock DockPanel.Dock="Top"
                       Text="Library"
                       Style="{StaticResource TitleText}"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,10"/>

            <TextBlock DockPanel.Dock="Top" Text="Loading..."
                       Visibility="{Binding Session.IsLoading, Converter={StaticResource BoolToVisibility}}"/>

            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,10"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SidebarBackgroundColor}"
                    Visibility="{Binding Session.IsCreatingPlaylist, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="New playlist name" Style="{StaticResource PrimaryTextBlock}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox Text="{Binding Session.NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300"/>
                        <Button Content="✓"
                                Command="{Binding ConfirmCreatePlaylistCommand}"
                                Style="{StaticResource IconButton}"
                                Width="40" Height="40"
                                ToolTip="Create"/>
                        <Button Content="✕"
                                Command="{Binding CancelCreatePlaylistCommand}"
                                Style="{StaticResource IconButton}"
                                Width="40" Height="40"
                                ToolTip="Cancel"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel>
                    <!-- Create Playlist tile -->
                    <Grid Margin="8" Width="160" Height="160">
                        <Border CornerRadius="12" Cursor="Hand"
                                Style="{StaticResource HoverTile}"
                                Background="{DynamicResource SidebarBackgroundColor}"
                                MouseLeftButtonUp="CreatePlaylist_Click">
                            <Border.Clip>
                                <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,160,160"/>
                            </Border.Clip>
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="120" Height="120" HorizontalAlignment="Center"
                                        CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource TextboxBackgroundColor}"
                                        Opacity="0.5">
                                    <TextBlock Text="+"
                                               FontSize="56"
                                               Foreground="{DynamicResource DisabledTextColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Create Playlist"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource PrimaryTextBlock}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Playlist tiles -->
                    <ItemsControl ItemsSource="{Binding Session.Playlists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8" Width="160" Height="160">
                                    <Border CornerRadius="12" Cursor="Hand"
                                            Style="{StaticResource HoverTile}"
                                            Background="{DynamicResource SidebarBackgroundColor}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Clip>
                                            <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,160,160"/>
                                        </Border.Clip>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Width="120" Height="120" HorizontalAlignment="Center"
                                                    CornerRadius="8" ClipToBounds="True"
                                                    Background="{DynamicResource TextboxBackgroundColor}">
                                                <Border.Clip>
                                                    <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,120,120"/>
                                                </Border.Clip>
                                                <Grid>
                                                    <Image Source="{Binding CachedCoverPath, Converter={StaticResource StringToImageSource}}"
                                                           Stretch="UniformToFill"/>

                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CachedCoverPath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CachedCoverPath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <TextBlock Text="♪"
                                                                   FontSize="48"
                                                                   Foreground="{DynamicResource DisabledTextColor}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"
                                                       Style="{StaticResource PrimaryTextBlock}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>